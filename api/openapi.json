 "components": {
  "schemas": {
   "BudgetReq": {
    "properties": {
     "time_budget_min": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "title": "Time Budget Min"
     },
     "from": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "From"
     },
     "dwell_min": {
      "type": "number",
      "minimum": 0.0,
      "title": "Dwell Min",
      "default": 30.0
     },
     "multi_stop": {
      "type": "boolean",
      "title": "Multi Stop",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "time_budget_min"
    ],
    "title": "BudgetReq"
   },
   "EmergencyReq": {
    "properties": {
     "position": {
      "additionalProperties": true,
      "type": "object",
      "title": "Position"
     },
     "suit_supply_left_h": {
      "type": "number",
      "minimum": 0.0,
      "title": "Suit Supply Left H"
     },
     "reserve_fraction": {
      "type": "number",
      "exclusiveMaximum": 1.0,
      "minimum": 0.0,
      "title": "Reserve Fraction",
      "default": 0.25
     }
    },
    "type": "object",
    "required": [
     "position",
     "suit_supply_left_h"
    ],
    "title": "EmergencyReq"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "MineralReq": {
    "properties": {
     "mineral": {
      "type": "string",
      "title": "Mineral"
     },
     "from": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "From"
     },
     "dwell_min": {
      "type": "number",
      "minimum": 0.0,
      "title": "Dwell Min",
      "default": 30.0
     }
    },
    "type": "object",
    "required": [
     "mineral"
    ],
    "title": "MineralReq"
   },
   "RouteReq": {
    "properties": {
     "to": {
      "additionalProperties": true,
      "type": "object",
      "title": "To"
     },
     "from": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "From"
     },
     "round_trip": {
      "type": "boolean",
      "title": "Round Trip",
      "default": true
     },
     "dwell_min": {
      "type": "number",
      "minimum": 0.0,
      "title": "Dwell Min",
      "default": 30.0
     }
    },
    "type": "object",
    "required": [
     "to"
    ],
    "title": "RouteReq"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}