    "operationId": "terrain_point_api_terrain_point_get",
    "parameters": [
     {
      "name": "east_m",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
